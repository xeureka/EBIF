# Environment variables for EBIF Platform
# PostgreSQL connection URL (recommend explicit sslmode=verify-full, e.g. postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=verify-full)
DATABASE_URL="postgresql://user:password@host/neondb?sslmode=verify-full"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
TRUSTED_ORIGINS=
IP_ADDRESS_HEADER=
RESEND_API_KEY="re_1234567890_placeholder"
EMAIL_FROM="Ethiopian Business & Investment Forum <events@nexabusinessgroup.com>"
EMAIL_REPLY_TO="events@nexabusinessgroup.com"
SITE_URL="https://ebif.nexabusinessgroup.com"
