{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "invest",
  // Set this to the date you first deploy. See:
  // https://developers.cloudflare.com/workers/configuration/compatibility-dates/
  "compatibility_date": "2026-10-26",
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    // Serve index.html for client-side routes that do not match a file,
    // so direct loads of TanStack Router URLs do not 404.
    "not_found_handling": "single-page-application",
  },
  "observability": {
    "enabled": true,
  },
  // Attach a custom domain after the zone is active in Cloudflare, then run
  // `pnpm deploy` again. Leave commented out until the domain is known.
  // "routes": [
  //   { "pattern": "example.com", "custom_domain": true }
  // ]
}
