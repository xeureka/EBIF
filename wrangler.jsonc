{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "ebif",
    "compatibility_date": "2026-10-26",
    "compatibility_flags": ["nodejs_compat"],
    "main": "src/server/index.ts",
    "preview_urls": true,
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*"],
    },
    "observability": {
        "enabled": true,
    },
}
